{
  "name": "jerrycurl-vscode",
  "displayName": "Jerrycurl for VS Code",
  "description": "Syntax highlighting, file icons and C# Dev Kit file templates for Jerrycurl .cssql (Razor SQL) and .orm files.",
  "version": "0.1.0",
  "publisher": "jerrycurl",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/thmskv/jerrycurl-vscode"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "jerrycurl",
    "cssql",
    "razor",
    "sql",
    "orm"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "ms-dotnettools.csdevkit"
  ],
  "contributes": {
    "commands": [
      {
        "command": "jerrycurl.installTemplates",
        "title": "Reinstall .cssql Item Templates",
        "category": "Jerrycurl"
      }
    ],
    "languages": [
      {
        "id": "cssql",
        "aliases": [
          "Jerrycurl SQL",
          "cssql"
        ],
        "extensions": [
          ".cssql"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/cssql-light.svg",
          "dark": "./icons/cssql-dark.svg"
        }
      },
      {
        "id": "jerrycurl-orm",
        "aliases": [
          "Jerrycurl ORM",
          "orm"
        ],
        "extensions": [
          ".orm"
        ],
        "configuration": "./language-configuration.orm.json",
        "icon": {
          "light": "./icons/orm-light.svg",
          "dark": "./icons/orm-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "cssql",
        "scopeName": "source.cssql",
        "path": "./syntaxes/cssql.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.cs": "csharp",
          "meta.embedded.line.cs": "csharp"
        }
      },
      {
        "language": "jerrycurl-orm",
        "scopeName": "source.json.orm",
        "path": "./syntaxes/orm.tmLanguage.json"
      }
    ],
    "jsonLanguageParticipants": [
      {
        "languageId": "jerrycurl-orm",
        "allowComments": false
      }
    ],
    "configurationDefaults": {
      "explorer.fileNesting.enabled": true,
      "explorer.fileNesting.expand": false,
      "explorer.fileNesting.patterns": {
        "*.orm": "$(capture).orm.cs, $(capture).orm.js, $(capture).orm.mjs, $(capture).orm.d.ts"
      }
    }
  },
  "scripts": {
    "test": "bun test",
    "tokens": "bun test/dump.mjs",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.0",
    "tm-grammars": "^1.22.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0"
  }
}
